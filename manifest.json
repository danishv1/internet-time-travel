{
  "manifest_version": 3,
  "name": "Internet Time Travel",
  "version": "1.0.1",
  "description": "Browse the web as if it were any past date you pick: archived sites, date-filtered Google and YouTube, era-correct feeds.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["declarativeNetRequest", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "2019 Internet", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/search*", "*://google.com/search*"],
      "js": ["content-google.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content-youtube.js"],
      "run_at": "document_start"
    }
  ]
}
